# ===== NoneBot2 基础 =====
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
COMMAND_START=["/"]
SUPERUSERS=["你的QQ号"]
NICKNAME=["宝可梦"]

# ===== OneBot v11 / v12 =====
# ONEBOT_ACCESS_TOKEN=
# ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]

# ===== QQ 官方机器人 =====
# QQ_BOTS=[{"id":"你的BotAppID","token":"你的Token","secret":"你的Secret","intent":{"at_message":true,"c2c_message":true}}]
# QQ_IS_SANDBOX=true

# ===== 宝可梦数据 =====
# POKEMON_DATA_DIR=D:/bot-data/pokemon
# POKEMON_RESOURCE_BASE_URL=https://silverwing.elysia.beauty/Pokemon
POKEMON_RESOURCE_AUTO_DOWNLOAD=true
POKEMON_COMMAND_PREFIXES=[]

# ===== 网页 / QWeb =====
POKEMON_WEB_ENABLED=true
POKEMON_WEB_PATH=/pokemon
POKEMON_QWEB_PATH=/qweb/pokemon
POKEMON_QWEB_ADMIN_PATH=/qweb/admin/pokemon
# POKEMON_QWEB_SECRET=change-me
POKEMON_WEB_ALLOW_GUEST=true

# ===== 网页 AI（OpenAI 兼容）=====
# POKEMON_LLM_BASE_URL=https://api.deepseek.com/v1
# POKEMON_LLM_API_KEY=sk-xxxx
# POKEMON_LLM_MODEL=deepseek-chat
POKEMON_LLM_ENABLED=true
POKEMON_LLM_PROVIDER=auto
POKEMON_LLM_MAX_STEPS=6
POKEMON_INTERACTION_TIMEOUT=60