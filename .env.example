# ===== NoneBot2 基础 =====
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
COMMAND_START=["/"]
SUPERUSERS=["你的QQ号"]
NICKNAME=["宝可梦"]

# ===== OneBot v11 / v12 =====
# ONEBOT_ACCESS_TOKEN=
# ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]

# ===== QQ 官方机器人 =====
# QQ_BOTS=[{"id":"你的BotAppID","token":"你的Token","secret":"你的Secret","intent":{"at_message":true,"c2c_message":true}}]
# QQ_IS_SANDBOX=true

# ===== 宝可梦数据 =====
# POKEMON_DATA_DIR=D:/bot-data/pokemon
# POKEMON_RESOURCE_BASE_URL=https://silverwing.elysia.beauty/Pokemon
POKEMON_RESOURCE_AUTO_DOWNLOAD=true
POKEMON_COMMAND_PREFIXES=[]

# ===== 存储后端（默认 SQLite）=====
# 独立兼容：不设置或 POKEMON_STORAGE=sqlite 时完全沿用旧 pokemon.db。
# 七七生产显式启用 PostgreSQL；schema/表由部署方导入，运行时不建表不改表。
# POKEMON_STORAGE=postgres
# 测试/standalone 可显式 DSN；生产留空时复用
# src.qi_web.config.get_settings().database_url。不要把真实 DSN 写进仓库。
# POKEMON_DATABASE_URL=<由部署方提供>

# ===== QWeb（默认关闭）=====
# 开启前必须确认当前 NoneBot 进程能导入宿主依赖 src.qi_web.dependencies:
#   require_membership / admin_account / csrf_protected
# 插件不读取任何客户端身份头，也没有游客模式。
POKEMON_WEB_ENABLED=false
POKEMON_QWEB_ENABLED=true
POKEMON_QWEB_PATH=/qweb/pokemon
POKEMON_QWEB_ADMIN_PATH=/qweb/admin/pokemon

# ===== 连续交互 =====
POKEMON_INTERACTION_TIMEOUT=60

# 说明：
# * 不在插件内配置模型/密钥/供应商；
# * AI 工具只注册到 MoEllmChats；
# * QWeb 聊天模型由宿主 /qweb/chat 中用户选择的 New API 模型决定。